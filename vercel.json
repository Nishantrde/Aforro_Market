{
  "version": 2,
  "builds": [
    {
      "src": "aforro_market/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "buildCommand": "./build.sh"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "aforro_market/wsgi.py"
    }
  ]
}